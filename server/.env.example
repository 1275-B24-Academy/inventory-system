# Copy thành .env rồi điền giá trị.

# --- Database ---
# Production (Neon): chỉ cần DATABASE_URL, có ?sslmode=require ở cuối.
# DATABASE_URL=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Local: bỏ trống DATABASE_URL và dùng các biến dưới.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inventory
DB_USER=postgres
DB_PASSWORD=postgres

# --- Auth ---
# Tạo bằng: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me

# --- Server ---
PORT=3000
# production: bật cờ Secure cho cookie refresh token
NODE_ENV=development
# Origin của client khi chạy dev (khác cổng). Production chung domain nên không cần.
CORS_ORIGIN=http://localhost:5173
