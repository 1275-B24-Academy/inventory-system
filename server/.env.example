# Copy thành .env rồi điền giá trị.

# --- Database ---
# Local: đổi user/password cho khớp Postgres trên máy (Postgres.app/Homebrew thường không cần password).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory
# Production (Neon): DATABASE_URL là URL pooled (host có "-pooler"), cuối có ?sslmode=require.
# Thêm URL direct (host KHÔNG có "-pooler") để `npm run db:migrate` dùng; local bỏ trống.
# DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# DB cho integration test (test tự tạo nếu chưa có, tên phải kết thúc bằng "_test").
# Chỉ cần bỏ comment dòng dưới khi Postgres local không dùng user/password postgres:postgres.
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_test

# --- Auth ---
# Tạo bằng: openssl rand -hex 32
JWT_ACCESS_SECRET=change-me

# --- Server ---
PORT=3000
# production: bật cờ Secure cho cookie refresh token
NODE_ENV=development
# Origin của client khi chạy dev (khác cổng). Production chung domain nên không cần.
CORS_ORIGIN=http://localhost:5173
